# ============================================================
# KBK Payroll System — environment configuration template
# Copy this file to `.env` and fill in REAL values.
# NEVER commit `.env` (it contains secrets). See .gitignore.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_NAME=KBK Payroll System

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Dialect: "postgres" (recommended) or "sqlite" (zero-setup demo mode)
DB_DIALECT=postgres

# PostgreSQL connection details (used when DB_DIALECT=postgres)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=payroll_db
DB_USER=payroll_app
DB_PASSWORD=change-me
# SSL only needed for some hosted Postgres (e.g. Render/Heroku) — leave false for local
DB_SSL=false

# SQLite file (used when DB_DIALECT=sqlite)
DB_FILE=./data/payroll.sqlite

# Run pending migrations automatically when the server starts (dev convenience)
DB_AUTO_MIGRATE=true

# --- Email (SMTP) — used from Stage 11 onwards ---
# Recommended: a dedicated Gmail account with an App Password (Google Account > Security > App passwords)
# Never use your personal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=payroll.kbk.school@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM_NAME=KBK Payroll
EMAIL_FROM_ADDRESS=payroll.kbk.school@gmail.com
