<%- include('../partials/head') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Payroll <%= run.period_year %>-<%= String(run.period_month).padStart(2, '0') %>
    <span class="badge text-bg-secondary">run #<%= run.run_number %></span>
    <% if (run.status === 'FINALISED') { %><span class="badge text-bg-success">FINALISED</span><% } else { %><span class="badge text-bg-warning">PROCESSED — review &amp; finalise</span><% } %>
  </h4>
  <div>
    <% if (run.status === 'PROCESSED' && can('payroll.finalise')) { %>
      <form method="POST" action="/payroll/<%= run.id %>/finalise" class="d-inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Finalising locks this payroll. Continue?')">✓ Finalise &amp; lock</button>
      </form>
    <% } %>
    <a href="/payroll" class="btn btn-sm btn-outline-secondary">Back to history</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-3"><div class="border rounded p-2 text-center small"><div class="fw-bold fs-5">GH₵ <%= Number(run.gross_total).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></div>Gross</div></div>
  <div class="col-md-3"><div class="border rounded p-2 text-center small"><div class="fw-bold fs-5">GH₵ <%= Number(run.deduction_total).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></div>Deductions</div></div>
  <div class="col-md-3"><div class="border rounded p-2 text-center small"><div class="fw-bold fs-5">GH₵ <%= Number(run.net_total).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></div>Net pay</div></div>
  <div class="col-md-3"><div class="border rounded p-2 text-center small"><div class="fw-bold fs-5"><%= run.employee_count %>/<%= activeEmployees %></div>Paid / active</div></div>
</div>

<% if (run.rerun_of_id) { %>
  <div class="alert alert-warning small">
    <strong>Re-run of run #<%= run.rerun_of_id %>.</strong> Reason: <%= run.rerun_reason %>.
    Original records were not modified — this is a separately numbered run.
  </div>
<% } %>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Reference</th><th>Employee</th><th class="text-end">Gross</th>
          <th class="text-end">SSNIT</th><th class="text-end">PAYE</th>
          <th class="text-end">Total deductions</th><th class="text-end">Net pay</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% payslips.forEach(function(p) { %>
          <tr>
            <td class="font-monospace small text-muted"><%= p.reference %></td>
            <td><%= p.employee.employee_no %> — <%= p.employee.first_name %> <%= p.employee.last_name %></td>
            <td class="text-end">GH₵ <%= Number(p.gross).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></td>
            <td class="text-end">GH₵ <%= Number(p.ssnit_amount).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></td>
            <td class="text-end">GH₵ <%= Number(p.paye_amount).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></td>
            <td class="text-end">GH₵ <%= Number(p.total_deductions).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></td>
            <td class="text-end fw-semibold">GH₵ <%= Number(p.net).toLocaleString('en-GH', { minimumFractionDigits: 2 }) %></td>
            <td><a href="/payslips/<%= p.id %>/pdf" class="btn btn-sm btn-outline-success">PDF</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (can('payroll.override')) { %>
  <div class="card shadow-sm mt-3">
    <div class="card-header bg-white fw-semibold text-danger">Administrator override — re-run this period</div>
    <div class="card-body">
      <p class="text-muted small mb-2">Creates a <strong>new numbered run</strong> for the same period with a recorded reason. Original payslips are never overwritten.</p>
      <form method="POST" action="/payroll/<%= run.id %>/rerun" class="row g-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-8">
          <input type="text" class="form-control form-control-sm" name="reason" placeholder="Reason for the re-run (required)" required>
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-sm btn-danger w-100" onclick="return confirm('Create a re-run for this period? This is audit-logged.')">Re-run period</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
