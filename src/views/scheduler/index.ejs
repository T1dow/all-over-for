<%- include('../partials/head') %>

<h4 class="mb-3">Scheduled processing</h4>

<div class="alert alert-info small">
  <strong>How it works:</strong> two cron jobs run inside the application process.
  The <strong>monthly payroll job</strong> fires on the configured pay day/time and processes the
  current period for all active employees — duplicate prevention (BR-01) still applies, so a period
  that already has a run is <em>skipped and audit-logged</em>, never double-processed. The
  <strong>email dispatcher</strong> fires every 5 minutes and sends due payslip notifications
  (PENDING, or RETRYING past its retry time).
  <% if (status.platform === 'vercel') { %>
    <br><span class="text-warning"><strong>Vercel mode:</strong> these jobs are provided by
    Vercel Cron Jobs (vercel.json) hitting /api/cron/* — see Settings → Cron Jobs. The
    "Run now" buttons below still work for instant testing.</span>
  <% } %>
</div>

<div class="row g-4">
  <% const jobs = [
       { key: 'payroll', label: 'Monthly payroll job', cron: status.payrollCron, desc: status.payrollLabel, enabled: status.payrollEnabled, last: status.lastPayrollRun },
       { key: 'email', label: 'Email dispatcher', cron: status.emailCron, desc: status.emailLabel, enabled: status.emailEnabled, last: status.lastEmailRun },
     ]; %>
  <% jobs.forEach(function(j) { %>
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <span class="fw-semibold"><%= j.label %></span>
          <% if (j.enabled) { %><span class="badge text-bg-success">RUNNING</span><% } else { %><span class="badge text-bg-secondary">PAUSED</span><% } %>
        </div>
        <div class="card-body">
          <p class="mb-1"><span class="font-monospace small text-muted"><%= j.cron %></span></p>
          <p class="text-muted small mb-3"><%= j.desc %></p>
          <p class="small mb-3"><strong>Last run:</strong> <span class="text-muted"><%= j.last %></span></p>
          <div class="d-flex gap-2">
            <form method="POST" action="/scheduler/toggle" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="job" value="<%= j.key %>">
              <input type="hidden" name="enabled" value="<%= j.enabled ? 'off' : 'on' %>">
              <button type="submit" class="btn btn-sm btn-outline-<%= j.enabled ? 'warning' : 'success' %>">
                <%= j.enabled ? 'Pause' : 'Enable' %>
              </button>
            </form>
            <form method="POST" action="/scheduler/run-now" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="type" value="<%= j.key %>">
              <button type="submit" class="btn btn-sm btn-primary">▶ Run now (test)</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<p class="text-muted small mt-4">
  Scheduled actions are audit-logged with the <strong>system actor</strong> (<code>scheduler@system.local</code>),
  so the trail always distinguishes automatic runs from human actions. Jobs are idempotent and safe to
  restart (FR-43).
</p>

<%- include('../partials/footer') %>
