<%- include('../partials/head') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white fw-semibold">Change password</div>
      <div class="card-body">
        <% if (typeof errors !== 'undefined' && errors.length) { %>
          <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
              <% errors.forEach(function(e) { %><li><%= e %></li><% }); %>
            </ul>
          </div>
        <% } %>
        <p class="text-muted small mb-3">Your administrator has asked you to set a new password before you can
          continue. Use at least 8 characters, including letters and numbers.</p>
        <form method="POST" action="/change-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label" for="current_password">Current password</label>
            <input type="password" class="form-control" id="current_password" name="current_password" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label" for="new_password">New password</label>
            <input type="password" class="form-control" id="new_password" name="new_password" required
                   minlength="8" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,}">
          </div>
          <div class="mb-3">
            <label class="form-label" for="confirm_password">Confirm new password</label>
            <input type="password" class="form-control" id="confirm_password" name="confirm_password" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Update password</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
