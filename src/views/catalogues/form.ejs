<%- include('../partials/head') %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header bg-white fw-semibold"><%= row ? 'Edit' : 'New' %> <%= kind === 'allowance' ? 'allowance' : 'deduction' %></div>
      <div class="card-body">
        <% if (errors.length) { %>
          <div class="alert alert-danger" role="alert">
            <ul class="mb-0"><% errors.forEach(function(e) { %><li><%= e %></li><% }); %></ul>
          </div>
        <% } %>

        <form method="POST" action="<%= row ? '/' + kind + 's/' + row.id : '/' + kind + 's' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" value="<%= values.name || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Code <span class="text-muted small">(unique, e.g. TRANSPORT)</span></label>
            <input type="text" class="form-control" name="code" value="<%= values.code || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Type</label>
            <select class="form-select" name="type">
              <option value="FIXED" <%= (values.type || 'FIXED') === 'FIXED' ? 'selected' : '' %>>Fixed amount (GHS)</option>
              <option value="PERCENT" <%= values.type === 'PERCENT' ? 'selected' : '' %>>Percentage of basic salary</option>
            </select>
          </div>
          <% if (kind === 'allowance') { %>
          <div class="form-check mb-3">
            <input type="hidden" name="taxable" value="off">
            <input class="form-check-input" type="checkbox" name="taxable" id="taxable" value="on"
                   <%= values.taxable === false || values.taxable === 'off' ? '' : 'checked' %>>
            <label class="form-check-label" for="taxable">Taxable (counts toward PAYE)</label>
          </div>
          <% } %>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Default amount (GHS)</label>
              <input type="number" step="0.01" min="0" class="form-control" name="default_amount"
                     value="<%= values.default_amount || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Default percent (%)</label>
              <input type="number" step="0.01" min="0" max="100" class="form-control" name="default_percent"
                     value="<%= values.default_percent || '' %>">
            </div>
          </div>
          <% if (row) { %>
          <div class="form-check mt-3">
            <input type="hidden" name="is_active" value="off">
            <input class="form-check-input" type="checkbox" name="is_active" id="is_active" value="on" <%= row.is_active ? 'checked' : '' %>>
            <label class="form-check-label" for="is_active">Active</label>
          </div>
          <% } %>
          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/<%= kind %>s" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
