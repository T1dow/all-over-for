<%- include('../partials/head') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Audit log <span class="text-muted fs-6">(<%= total %> entries)</span></h4>
</div>

<div class="alert alert-secondary small py-2">
  Append-only trail of every sensitive action — logins, user management, employee &amp; salary changes,
  payroll runs (including blocked duplicates), payslip views, email events, scheduler activity and
  settings changes. Entries cannot be edited or deleted from the application.
</div>

<form method="GET" action="/audit" class="row g-2 mb-3">
  <div class="col-md-2">
    <select class="form-select form-select-sm" name="action">
      <option value="">All actions</option>
      <% actions.forEach(function(a) { %>
        <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-md-2">
    <input type="text" class="form-control form-control-sm" name="user" placeholder="Actor email…" value="<%= filters.user %>">
  </div>
  <div class="col-md-2">
    <select class="form-select form-select-sm" name="entity">
      <option value="">All entities</option>
      <% entityTypes.forEach(function(e) { %>
        <option value="<%= e %>" <%= filters.entity === e ? 'selected' : '' %>><%= e %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-md-2">
    <input type="date" class="form-control form-control-sm" name="from" value="<%= filters.from %>" title="From date">
  </div>
  <div class="col-md-2">
    <input type="date" class="form-control form-control-sm" name="to" value="<%= filters.to %>" title="To date">
  </div>
  <div class="col-md-2">
    <button class="btn btn-sm btn-primary w-100">Filter</button>
  </div>
</form>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>#</th><th>Timestamp</th><th>Actor</th><th>Action</th>
          <th>Entity</th><th>Detail</th><th>IP</th>
        </tr>
      </thead>
      <tbody>
        <% entries.forEach(function(e) { %>
          <tr>
            <td class="text-muted small"><%= e.id %></td>
            <td class="small text-nowrap"><%= new Date(e.created_at).toLocaleString('en-GB') %></td>
            <td class="small"><%= e.user_email || '—' %></td>
            <td><span class="badge text-bg-secondary"><%= e.action %></span></td>
            <td class="small text-muted"><%= e.entity_type %><% if (e.entity_id) { %> #<%= e.entity_id %><% } %></td>
            <td class="small" style="max-width:340px">
              <span class="d-inline-block text-truncate" style="max-width:340px"
                    title="<%= e.detail ? JSON.stringify(e.detail) : '' %>"><%= e.detail ? JSON.stringify(e.detail) : '—' %></span>
            </td>
            <td class="small text-muted"><%= e.ip_address || '—' %></td>
          </tr>
        <% }); %>
        <% if (!entries.length) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No audit entries match your filters.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<% if (pages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination pagination-sm">
      <% for (let p = 1; p <= pages; p++) { %>
        <li class="page-item <%= p === page ? 'active' : '' %>">
          <a class="page-link" href="/audit?page=<%= p %>&action=<%= encodeURIComponent(filters.action) %>&user=<%= encodeURIComponent(filters.user) %>&entity=<%= encodeURIComponent(filters.entity) %>&from=<%= filters.from %>&to=<%= filters.to %>"><%= p %></a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>

<%- include('../partials/footer') %>
